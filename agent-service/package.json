{
  "name": "karos-agent-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent execution service wrapping the Claude Agent SDK for karos-agents jobs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/queue/worker-main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "AGENT_E2E=1 vitest run test/e2e",
    "mock-webhook": "tsx tools/mock-webhook.ts",
    "demo-job": "tsx tools/demo-job.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@fastify/multipart": "^9.2.1",
    "@google-cloud/run": "^3.1.0",
    "@google-cloud/storage": "^7.16.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.56.0",
    "fastify": "^5.4.0",
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
