{
  "$id": "brief/blog_article",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic"],
  "properties": {
    "topic": { "type": "string", "minLength": 3, "maxLength": 500 },
    "target_keyword": { "type": "string", "maxLength": 200 },
    "length": { "type": "string", "enum": ["short", "standard", "long"], "default": "standard" },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
