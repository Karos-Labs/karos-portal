{
  "$id": "brief/landing_page",
  "type": "object",
  "additionalProperties": false,
  "required": ["page_goal"],
  "properties": {
    "page_goal": { "type": "string", "minLength": 3, "maxLength": 500 },
    "offer": { "type": "string", "maxLength": 1000 },
    "sections": {
      "type": "array",
      "maxItems": 15,
      "items": { "type": "string", "maxLength": 200 }
    },
    "reference_urls": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
