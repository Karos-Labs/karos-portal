{
  "$id": "brief/social_post",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "post_type": {
      "type": "string",
      "maxLength": 120,
      "description": "Which emitted sub-skill/format to run, e.g. 'expert-tips'. Omit to let the agent pick from the client's content system."
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
    "topic": { "type": "string", "maxLength": 500 },
    "platform": { "type": "string", "enum": ["instagram", "tiktok", "both"], "default": "both" },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
