# Copy to .env (gitignored) and fill in secrets.
#
# HOW THIS FILE IS READ:
#  - `docker compose` (make up / make demo-job) uses it only for substitution —
#    the vars that matter there are ANTHROPIC_API_KEY, AGENT_SERVICE_TOKENS,
#    AGENT_WEBHOOK_SECRET, and PUBLIC_BASE_URL; everything else is set per
#    service in docker-compose.yml.
#  - Running the service directly on the host (`npm run dev`) reads ALL vars.
#  - Production (Cloud Run) takes none of this: secrets come from GCP Secret
#    Manager via agent-service/cloudbuild.yaml --set-secrets.
#  - GITHUB_TOKEN for the runner image build is NOT read from here — pass it
#    on the command line: GITHUB_TOKEN=$(gh auth token) make runner

# --- required ---
# Accepted bearer tokens for the platform-facing API (comma-separated to allow rotation)
AGENT_SERVICE_TOKENS=dev-token
# HMAC secret for signing outbound webhooks to the platform
AGENT_WEBHOOK_SECRET=dev-webhook-secret

# --- anthropic (required to actually run jobs) ---
# Lives ONLY here; never in the platform or client code
ANTHROPIC_API_KEY=

# --- apify (optional; LinkedIn seat voice-collection + IG/TikTok legs) ---
# One company token, shared across Apify legs. Skills degrade to no-posts when unset.
APIFY_TOKEN=

# --- core ---
PORT=8080
REDIS_URL=redis://localhost:6379
# URL job containers use to reach this service (docker compose: http://api:8080)
INTERNAL_BASE_URL=http://localhost:8080
# URL used in artifact links handed to the platform
PUBLIC_BASE_URL=http://localhost:8080

# --- storage: local (dev) or gcs (prod) ---
ARTIFACT_STORE=local
ARTIFACTS_DIR=./data
# AGENT_ARTIFACTS_BUCKET=karos-agent-artifacts

# --- execution: docker (dev) or cloudrun (prod) ---
EXECUTOR=docker
RUNNER_IMAGE=karos-agent-runner:latest
# Attach job containers to this network (compose: the internal no-egress network)
# DOCKER_NETWORK=agent-service_jobs-internal
# Egress proxy injected into job containers (compose: http://proxy:8888)
# JOB_HTTP_PROXY=http://proxy:8888
# CLOUDRUN_PROJECT=
# CLOUDRUN_REGION=
# CLOUDRUN_JOB=

# --- tuning ---
JOB_DEFAULT_TIMEOUT_MS=900000
JOB_MAX_ATTEMPTS=2
JOB_TTL_SECONDS=2592000
WORKER_CONCURRENCY=2
# RUN_WORKER_IN_PROCESS=1

# ── Dynamic Agent Studio code steps ──────────────────────────────────
# Must be exactly "true" for the runner to execute a spec's code step at all;
# anything else fails that step with an English reason and leaves AI-only
# dynamic agents fully functional. Keep in sync with the Portal's copy of this
# variable, which gates the Studio's editor.
DYNAMIC_CODE_STEPS_ENABLED=false

# Image used for the code sandbox's STRONG tier. When this is set and a Docker
# daemon is reachable, each code step runs in a throwaway container with
# --network none, --read-only + a size-capped noexec tmpfs scratch dir,
# --user 10001:10001, --cap-drop ALL, --security-opt no-new-privileges, a real
# --memory cgroup and --pids-limit; that is the tier where Phase 7's hard
# requirements are kernel-enforced. Unset (or no daemon, as on Cloud Run) falls
# back to the local tier: same contract and the same wall-clock/stdout/CPU/
# file-size caps, with network and filesystem confinement enforced at the
# interpreter level instead of by the kernel. The image needs python3 and node
# on PATH plus busybox `sh` and `base64`.
DYNAMIC_CODE_SANDBOX_IMAGE=
