# ─────────────────────────────────────────────────────────────
# Karos CMO — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Who becomes an admin automatically on first login (comma-separated emails).
ADMIN_EMAILS=hello@karoslabs.com

# ── Firebase Web SDK (client) ────────────────────────────────
# Firebase console → Project settings → General → Your apps → SDK setup & config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server) ──────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON on one line (recommended):
FIREBASE_SERVICE_ACCOUNT_KEY=
# …or instead set these three discrete values:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Anthropic (Claude) — powers the copilot, tasks & intel ───
ANTHROPIC_API_KEY=

# ── Resend — emails generated content to clients ─────────────
RESEND_API_KEY=
EMAIL_FROM="Karos CMO <hello@karoslabs.com>"

# ── Fireflies — transcript ingestion ─────────────────────────
FIREFLIES_API_KEY=
# Optional shared secret to authenticate the webhook:
#   webhook URL → https://yourapp.com/api/ingest/fireflies?secret=YOUR_SECRET
FIREFLIES_WEBHOOK_SECRET=

# ── Agent service — external karos-agents job execution ──────
# Base URL of the agent-service API (Cloud Run service or http://localhost:8080).
# When set, the Managed products UI appears on the client Agents page.
AGENT_SERVICE_URL=http://localhost:8080
# App token the platform sends (in the X-Karos-Service-Token header) to the
# agent service; matches one of the service's AGENT_SERVICE_TOKENS entries.
AGENT_SERVICE_TOKEN=dev-token
# Prod only: set to the agent api URL to enable the Cloud Run IAM ID token
# (sent in Authorization) alongside the app token. Leave empty locally (no IAM).
AGENT_SERVICE_AUDIENCE=
# Public base URL the agent service posts webhooks back to (this platform's URL).
# Dedicated runtime var so it isn't inlined at build like NEXT_PUBLIC_*; falls
# back to NEXT_PUBLIC_APP_URL when unset.
AGENT_SERVICE_CALLBACK_URL=
# HMAC secret(s) for verifying agent-service webhooks, comma-separated for
# rotation. MUST be set — the webhook receiver rejects everything without it.
AGENT_WEBHOOK_SECRET=dev-webhook-secret
# GitHub token with READ access to the karos-agents repo — enables the staff
# "Import lab outputs" flow (pulls committed clients/<slug>/outputs runs into
# the platform as draft assets). Local dev: `gh auth token` works.
AGENTS_REPO_GITHUB_TOKEN=
# Override the lab repo (owner/name); defaults to karoslabs/karos-agents.
# AGENTS_REPO=karoslabs/karos-agents
