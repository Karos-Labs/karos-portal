# ─────────────────────────────────────────────────────────────
# Karos CMO — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Who becomes an admin automatically on first login (comma-separated emails).
ADMIN_EMAILS=hello@karoslabs.com

# ── Firebase Web SDK (client) ────────────────────────────────
# Firebase console → Project settings → General → Your apps → SDK setup & config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server) ──────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON on one line (recommended):
FIREBASE_SERVICE_ACCOUNT_KEY=
# …or instead set these three discrete values:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Anthropic (Claude) — powers every agent ──────────────────
ANTHROPIC_API_KEY=

# ── Higgsfield "Soul" image generation (via Segmind) ─────────
# Powers Instagram post visuals. Without it, posts have captions but no images.
# Get a key at https://www.segmind.com → API keys.
# Generated images are stored in your Firebase Storage bucket
# (NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET above) — no extra storage config needed.
SEGMIND_API_KEY=
# Optional image tuning for the Higgsfield "Soul" model (sensible defaults apply):
#   SEGMIND_SOUL_STYLE_ID — a style UUID. Defaults to "Realistic"
#     (1cb4b936-77bf-4f9a-9039-f3d349a4cdbe), the photographic style. Other
#     options: DigitalCam ca4e6ad3-3e93-4e03-81a0-d1722d2c128b, Quiet luxury
#     ff1ad8a2-94e7-4e70-a12f-e992ca9a0d36. (The model's own default,
#     b3c8075a-…, is the "Creatures" style — avoid it, it ignores the prompt.)
#   SEGMIND_SOUL_SIZE — one of the model's allowed dimensions, e.g. 1152x1536
#     (portrait, default), 1536x1536 (square), 1536x2048.
#   SEGMIND_SOUL_STYLE_STRENGTH — 0–1, how strongly the style preset applies
#     (default 0.5; lower lets the prompt drive the look).
SEGMIND_SOUL_STYLE_ID=
SEGMIND_SOUL_SIZE=
SEGMIND_SOUL_STYLE_STRENGTH=

# ── Apify — real photo sourcing for the Content Engine (e12) ──
# The content engine runs an Apify Google Images scraper actor to pull REAL
# photographs (no AI generation) for carousel slides, filtered by the client's
# sourcing rules and re-hosted to your Firebase Storage bucket. Without it,
# content-engine runs produce copy + image queries but no photos.
# API token at https://console.apify.com/account/integrations.
APIFY_TOKEN=
# Optional — override the scraper actor (username~actor). Any actor whose dataset
# items carry an image URL + pixel dimensions works.
APIFY_IMAGE_ACTOR=hooli~google-images-scraper

# ── Resend — emails generated content to clients ─────────────
RESEND_API_KEY=
EMAIL_FROM="Karos CMO <hello@karoslabs.com>"

# ── Fireflies — transcript ingestion ─────────────────────────
FIREFLIES_API_KEY=
# Optional shared secret to authenticate the webhook:
#   webhook URL → https://yourapp.com/api/ingest/fireflies?secret=YOUR_SECRET
FIREFLIES_WEBHOOK_SECRET=

# ── Agent service — external karos-agents job execution ──────
# Base URL of the agent-service API (Cloud Run service or http://localhost:8080).
# When set, the Managed products UI appears on the client Agents page.
AGENT_SERVICE_URL=http://localhost:8080
# App token the platform sends (in the X-Karos-Service-Token header) to the
# agent service; matches one of the service's AGENT_SERVICE_TOKENS entries.
AGENT_SERVICE_TOKEN=dev-token
# Prod only: set to the agent api URL to enable the Cloud Run IAM ID token
# (sent in Authorization) alongside the app token. Leave empty locally (no IAM).
AGENT_SERVICE_AUDIENCE=
# HMAC secret(s) for verifying agent-service webhooks, comma-separated for
# rotation. MUST be set — the webhook receiver rejects everything without it.
AGENT_WEBHOOK_SECRET=dev-webhook-secret
