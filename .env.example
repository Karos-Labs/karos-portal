# ─────────────────────────────────────────────────────────────
# Karos CMO — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Who becomes an admin automatically on first login (comma-separated emails).
ADMIN_EMAILS=hello@karoslabs.com
# Single-address STAFF recipient for internal notifications (copilot support
# requests via /api/clients/[id]/chat, other internal alert mail) — distinct
# from ADMIN_EMAILS above (auto-admin allowlist) and from the failure-alert
# list wired at deploy as its own substitution (job-alerts.ts). Wired at
# deploy via cloudbuild's _ADMIN_EMAIL. Absent = falls back to
# "hello@karoslabs.com" (support-actions.ts, user-actions.ts) or, in the
# copilot support-request path, logs to console instead of emailing.
ADMIN_EMAIL=hello@karoslabs.com

# ── Firebase Web SDK (client) ────────────────────────────────
# Firebase console → Project settings → General → Your apps → SDK setup & config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only override of the default Cloud Storage bucket — takes priority
# over NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET above when set (src/lib/firebase/admin.ts).
# Unset (the normal case) = uses the NEXT_PUBLIC_ value; there is no reason to
# set this unless the server-side bucket must differ from the client SDK's.
# FIREBASE_STORAGE_BUCKET=

# ── Firebase Admin SDK (server) ──────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the ENTIRE downloaded JSON on one line (recommended):
FIREBASE_SERVICE_ACCOUNT_KEY=
# …or instead set these three discrete values:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Anthropic (Claude) — powers the copilot, tasks & intel ───
ANTHROPIC_API_KEY=
# Not read by application code — only by a handful of local-only scripts
# (scripts/backfill-fireflies-meetings-locally.ts and its siblings), which
# actively DELETE an ambient shell value of exactly
# "https://api.anthropic.com" (missing the SDK's required /v1 suffix) rather
# than use it, because that stray value 404s every call. Leave unset; only
# relevant if your shell happens to export it.
# ANTHROPIC_BASE_URL=
# Which vendor AI calls default to when a role doesn't pin one — "anthropic"
# (default, i.e. today's behaviour) or "vertex". Throws at call time on any
# other value (src/lib/ai/provider.ts). Optional; almost never needs setting.
# AI_VENDOR=anthropic

# ── Analytics live ingestion ─────────────────────────────────
# Set to "1" to turn on LIVE per-post metric fetching in /api/analytics/sync.
# Off/absent = deterministic mock metrics (dev/demo). Flip on in the GCP runtime
# once real platform tokens are connected.
ANALYTICS_LIVE_INGEST=
# 32-byte key (hex-64 or base64) encrypting LinkedIn employee-seat OAuth tokens
# at rest (AES-256-GCM). REQUIRED in production to store seat tokens; dev without
# it stores a `plain:` marker. Generate: `openssl rand -hex 32`.
TOKEN_ENCRYPTION_KEY=

# ── Staff auth & internal identity ───────────────────────────
# Shared key that lets a signup claim the KAROS_EMPLOYEE role (src/lib/auth.ts,
# validateInvitationKeyAction in client-actions.ts). Unset = the staff-key path
# never matches, so nobody can self-provision as staff (signups still work,
# they just can't claim KAROS_EMPLOYEE). Treat as a secret.
KAROS_STAFF_KEY=
# The one email address that gets KAROS_ADMIN (not just KAROS_EMPLOYEE) when it
# signs up with a valid KAROS_STAFF_KEY above. Defaults to
# "hello@karoslabs.com" if unset (src/lib/constants.ts COMPANY_ALIAS_EMAIL).
# KAROS_COMPANY_ALIAS=hello@karoslabs.com
# Staff inbox that receives the public "new client request" form submission
# (src/lib/actions/request-actions.ts). Defaults to "hello@karoslabs.com" if
# unset — distinct from ADMIN_EMAIL above (different call site, same default).
# KAROS_EMAIL=hello@karoslabs.com

# ── Cron / background jobs ───────────────────────────────────
# Bearer secret authenticating the scheduled routes (/api/publish,
# /api/cleanup-logs, /api/analytics/sync, /api/*/reconcile). Cloud Scheduler
# sends it as `Authorization: Bearer <CRON_SECRET>`. REQUIRED in production (the
# routes fail closed with 503 when unset); locally it may be blank.
CRON_SECRET=

# ── BI telemetry (BigQuery) ──────────────────────────────────
# Feeds src/lib/telemetry/bi-tracker.ts (agent_runs_bi / user_actions_bi /
# credit_usage_bi). Unset locally = every track*() call silently no-ops, no
# local BigQuery/ADC needed. Provisioned by deploy/bootstrap-bi-telemetry-gcp.sh.
# The GCP project this Cloud Run service runs in (karoscmo / karoscmo-prep):
GOOGLE_CLOUD_PROJECT=
# BigQuery dataset holding the BI tables. Defaults to "bi_telemetry" if unset.
# BQ_DATASET_ID=bi_telemetry

# ── Firestore ─────────────────────────────────────────────────
# Named Firestore database this service opens — "(default)" is production,
# "prep" is prep's own isolated database in the same shared Firebase project
# (src/lib/firebase/admin.ts, scripts/lib/firestore-db.ts). Wired at deploy
# via cloudbuild's _FIRESTORE_DATABASE_ID. Also doubles as the prep/prod
# telemetry-environment signal in src/instrumentation.node.ts. Unset locally
# falls back to "(default)" in admin.ts; scripts/lib/firestore-db.ts instead
# REFUSES to run unset (SCRUM-374) — see that file for why the two differ.
FIRESTORE_DATABASE_ID=

# ── SEO/GEO visibility capture (multi-model answer engines) ──
# Used by the onboarding pipeline's SEO/GEO vertical to ask buyer-intent
# questions to each answer engine and measure brand visibility.
# In production these are injected via GCP Secret Manager — env only, never
# hardcode values. A missing key degrades that engine to UNAVAILABLE (non-fatal).
# OpenAI service-account key (sk-svcacct-…) — answers the ChatGPT column:
OPENAI_API_KEY=
# Google AI Studio / Gemini API key — answers the Gemini column (search-grounded):
GEMINI_API_KEY=
# Optional: override the capture model ids without a code change (defaults live in
# constants.ts SEO_GEO_CAPTURE). Set these if a provider deprecates the default model
# ("no longer available to new users"). Defaults: gpt-4o-mini / gemini-3.5-flash.
# OPENAI_CAPTURE_MODEL=
# GEMINI_CAPTURE_MODEL=

# ── Social channel OAuth (client integrations) ───────────────
# Per-provider app credentials for the "Connect with …" OAuth flow on the client
# Integrations tab. Each provider is optional — a missing pair just hides that
# provider's Connect button (manual token entry still works). In production these
# are injected via GCP Secret Manager — never hardcode real values here.
# Shared: HMAC key signing the OAuth `state` token (REQUIRED in production) and the
# public app origin used to build the OAuth redirect URI.
OAUTH_STATE_SECRET=
# Not NEXT_PUBLIC_-prefixed on purpose: this base URL is only ever read in
# server-side code (OAuth callbacks, email links, webhook fallbacks). A
# NEXT_PUBLIC_ var gets inlined into the compiled bundle at `next build` time —
# since production is promoted from an already-built prep image with no
# rebuild (see cloudbuild.promote.yaml), a NEXT_PUBLIC_ var here would keep
# whatever URL was baked in at build time no matter what's set at deploy time.
APP_URL=http://localhost:3000
# NOT the same variable as APP_URL above, and — per this file's own note on
# APP_URL not being NEXT_PUBLIC_-prefixed "on purpose" — likely a latent bug
# rather than a deliberate second URL: read as a fallback in
# src/lib/jobs/submit-custom.ts (webhook callback origin) and unconditionally
# in src/lib/integrations/jira.ts (built into the Jira issue description
# link). Neither cloudbuild.yaml nor cloudbuild.promote.yaml ever sets or
# --build-args it, so in every currently-deployed environment
# process.env.NEXT_PUBLIC_APP_URL is undefined: the jira.ts link renders with
# a blank origin ("/transcripts/<id>") and the submit-custom.ts fallback
# never has anything to fall back to. Flagged here as a real, currently-live
# gap (SCRUM-332 finding) rather than fixed — deciding whether these two call
# sites should read APP_URL instead, or whether this needs to become build-arg
# wired like the Firebase NEXT_PUBLIC_ vars, is a product/code call this
# config-inventory ticket does not make.
# NEXT_PUBLIC_APP_URL=
# Primary LinkedIn app — Sign In with LinkedIn + Share on LinkedIn (personal
# posting, employee-seat OAuth). This is the ONLY LinkedIn app these two vars
# should ever point at.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# SEPARATE LinkedIn app — Community Management API (company-page followers/
# demographics/admin analytics). LinkedIn does not allow this product to
# coexist with Sign In/Share on one app — requesting r_organization_social/
# r_organization_admin from the app above 400s the ENTIRE auth request, even
# for clients only using personal posting. Create a second app in the
# LinkedIn Developer Portal with ONLY the Community Management API product
# added, and put its credentials here instead:
LINKEDIN_COMMUNITY_CLIENT_ID=
LINKEDIN_COMMUNITY_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# TikTok Login Kit v2 — the app credential is a "client key" (not "client id").
# Register at https://developers.tiktok.com → Manage apps → Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Reddit "web app" OAuth client — register at https://www.reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Extended/read-scope approval flags ───────────────────────────────
# The platform requests base scopes today (publish + own basic metrics). These
# flip on ADDITIONAL scopes (comments, mentions) that the platform will only
# grant once its separate partner/review product is approved for our app — see
# extendedScopes in oauth.ts. Flipping one of these BEFORE approval lands
# doesn't just no-op: the platform rejects the whole OAuth request, breaking
# the already-working base connection for every client. Only set to "1" after
# the platform confirms the product is live.
# (LinkedIn's equivalent is NOT a flag here — it's a wholly separate app;
# see LINKEDIN_COMMUNITY_CLIENT_ID/SECRET above.)
# Meta App Review approved (pages_read_user_content, pages_show_list, read_insights):
META_ADVANCED_ACCESS_APPROVED=
# TikTok Research API / elevated Content Posting access approved:
TIKTOK_RESEARCH_API_APPROVED=
# Google Business Profile API access request approved for this GCP project —
# adds business.manage to the "Connect all Google services" consent screen.
# Setting this before Google approves re-breaks EVERY other Google service
# (YouTube, Search Console, Analytics): Google rejects the whole authorize
# request with "Access blocked: this app's request is invalid".
GOOGLE_BUSINESS_PROFILE_APPROVED=

# ── Google Search Console / Analytics / Business Profile ─────────────
# All three reuse the GOOGLE_CLIENT_ID/SECRET app above with an added scope —
# enable each API on that GCP project first (APIs & Services → Library):
#   Search Console API, Analytics Data API (GA4), Business Profile APIs.
# Business Profile additionally requires Google to approve a manual access
# request (https://developers.google.com/my-business/content/prereqs) before
# it returns real data — the other two work as soon as the API is enabled and
# the client grants this account access to their property/site.
# No new env vars beyond GOOGLE_CLIENT_ID/SECRET; per-client site/property ids
# are entered as integration fields (Search Console Property / GA4 Property ID
# / Business Profile Location ID) on the client's Integrations tab.

# ── Client GitHub repo reads (X/newsletter "shipped work" signal) ────
# Distinct from AGENTS_REPO_GITHUB_TOKEN below (that one reads Karos's own lab
# repo). Optional — raises the unauthenticated GitHub rate limit (60/hr) to
# 5000/hr for reading a CLIENT's public repo; leave unset to stay unauthenticated.
GITHUB_READ_TOKEN=

# ── Resend — emails generated content to clients ─────────────
RESEND_API_KEY=
EMAIL_FROM="Karos Labs <hello@karoslabs.com>"

# ── Fireflies — transcript ingestion ─────────────────────────
FIREFLIES_API_KEY=
# Optional shared secret to authenticate the webhook:
#   webhook URL → https://yourapp.com/api/ingest/fireflies?secret=YOUR_SECRET
FIREFLIES_WEBHOOK_SECRET=
# Override the model used to summarize a transcript into
# summary/action-items/keywords (src/lib/transcripts/ingest.ts). Optional —
# defaults to MODELS.SONNET (constants.ts) if unset.
# TRANSCRIPT_MODEL=

# ── Agent service — external karos-agents job execution ──────
# Base URL of the agent-service API (Cloud Run service or http://localhost:8080).
# When set, the Managed products UI appears on the client Agents page.
AGENT_SERVICE_URL=http://localhost:8080
# App token the platform sends (in the X-Karos-Service-Token header) to the
# agent service; matches one of the service's AGENT_SERVICE_TOKENS entries.
AGENT_SERVICE_TOKEN=dev-token
# Prod only: set to the agent api URL to enable the Cloud Run IAM ID token
# (sent in Authorization) alongside the app token. Leave empty locally (no IAM).
AGENT_SERVICE_AUDIENCE=
# Public base URL the agent service posts webhooks back to (this platform's URL).
# Dedicated runtime var, kept separate from the OAuth-facing APP_URL below in
# case the two ever need to differ. Falls back to APP_URL when unset.
AGENT_SERVICE_CALLBACK_URL=
# HMAC secret(s) for verifying agent-service webhooks, comma-separated for
# rotation. MUST be set — the webhook receiver rejects everything without it.
AGENT_WEBHOOK_SECRET=dev-webhook-secret

# ── Agent engine — the agent-service replacement (Pub/Sub dispatch) ─────
# src/lib/jobs/submit-managed.ts / src/lib/agent-engine/*
#
# Default OFF: this deployment keeps dispatching every managed job through
# the legacy agent-service HTTP path above until this is explicitly "true".
# Flip it back to unset/"false" to revert instantly — nothing else here
# needs to change.
AGENT_ENGINE_DISPATCH_ENABLED=false
# The Pub/Sub topic agent-engine's queue consumer subscribes to
# (agent-engine's own QUEUE_TOPIC_RUN_JOBS/QUEUE_SUBSCRIPTION_RUN_JOBS must
# point at the SAME topic). Left unset locally: publishAgentEngineRun()
# then throws instead of silently no-op'ing, UNLESS PUBSUB_EMULATOR_HOST is
# set instead — the official @google-cloud/pubsub client auto-detects that
# var and talks to the emulator, no other config needed for local dev.
AGENT_ENGINE_PUBSUB_TOPIC=karos-agent-runs-prep
# PUBSUB_EMULATOR_HOST=localhost:8085
#
# Base URL of agent-engine's own Cloud Run service (or http://localhost:8080)
# — used ONLY for the two synchronous calls Pub/Sub can't do: gate
# resolution and status polling (src/lib/agent-engine/client.ts).
AGENT_ENGINE_URL=http://localhost:8081
# Prod only: set to agent-engine's own URL to send a Cloud Run IAM ID token
# alongside every request — mirrors AGENT_SERVICE_AUDIENCE above. As of this
# writing agent-engine's /api/v1/runs/* routes don't check it yet; sending
# it anyway costs nothing and is ready for whenever that's turned on.
AGENT_ENGINE_AUDIENCE=
#
# --- Dispatch via agent-middleware (the control plane) -----------------------
# Off by default. Off, this repo publishes to AGENT_ENGINE_PUBSUB_TOPIC itself
# and the engine runs whatever prompt/template is baked into its image. On,
# dispatch goes through agent-middleware, which resolves the agent's ACTIVE
# prompt version, template version and GCS assets, records a run they're
# attached to, and publishes that — which is what lets feedback point at an
# exact prompt version.
#
# Independent of AGENT_ENGINE_DISPATCH_ENABLED: that decides WHETHER a product
# uses agent-engine, this decides HOW the job gets there.
#
# Requires agent-middleware to be deployed and reachable. Both this flag and
# AGENT_MIDDLEWARE_URL must be set for it to take effect; anything other than
# the literal "true" is treated as off.
AGENT_MIDDLEWARE_DISPATCH_ENABLED=false
# Base URL of the agent-middleware Cloud Run service.
AGENT_MIDDLEWARE_URL=
# Set to the same URL in a deployed environment: it becomes the 'aud' of the
# OIDC identity token sent on every dispatch. The middleware REQUIRES a
# matching AUTH_AUDIENCE and rejects tokens without one. Leave blank locally
# (no IAM in front) and give the middleware AUTH_ENABLED=false or a dev token.
AGENT_MIDDLEWARE_AUDIENCE=
# HMAC secret for signing job-scoped MCP tokens — the credential a running job
# presents to /api/mcp to pull its client's data / upload artifacts mid-run.
# Optional: unset falls back to the first AGENT_WEBHOOK_SECRET; if neither is
# set, jobs still run but without mid-run MCP callback access.
MCP_JOB_TOKEN_SECRET=
# GitHub token with READ access to the karos-agents repo — enables the staff
# "Import lab outputs" flow (pulls committed clients/<slug>/outputs runs into
# the platform as draft assets). Local dev: `gh auth token` works.
AGENTS_REPO_GITHUB_TOKEN=
# Override the lab repo (owner/name); defaults to karoslabs/karos-agents.
# AGENTS_REPO=karoslabs/karos-agents
# Which clients may route CUSTOM-agent jobs to agent-engine, as a
# comma-separated list of agentsRepoSlug (or "*" for every client — note the
# literal "*", not "all"). Wired at deploy via cloudbuild's
# _AGENT_ENGINE_CUSTOM_AGENT_CLIENTS (src/lib/agent-engine/product-mapping.ts).
# Unset/empty = nobody routed.
AGENT_ENGINE_CUSTOM_AGENT_CLIENTS=

# ── Runway autopilot (/api/runway) ───────────────────────────
# Off by default. "1" turns on auto-dispatch of the weekly content-runway
# top-up; off, the route still measures and reports deficits, it just doesn't
# act on them. Wired at deploy via cloudbuild's _RUNWAY_AUTOGEN_ENABLED.
RUNWAY_AUTOGEN_ENABLED=
# Per-client cap on jobs one sweep may dispatch. Must stay equal to
# RUNWAY_HORIZON_DAYS in src/lib/runway.ts — runway.test.ts pins the two
# together, and cloudbuild's own comment explains why: a first sweep needs to
# fill the FULL deficit, not throttle to some smaller number. Wired at
# deploy via cloudbuild's _RUNWAY_MAX_JOBS_PER_CLIENT (default "14").
# RUNWAY_MAX_JOBS_PER_CLIENT=14

# ── Task Map autopilot (/api/tasks/auto-generate) ────────────
# Off by default, same convention as the runway toggle above.
TASKMAP_AUTOGEN_ENABLED=
# How many clients one sweep may run the (expensive, ~120s) swarm debate for.
# Wired at deploy via cloudbuild's _TASKMAP_AUTOGEN_SWEEP_CAP (default "3").
# TASKMAP_AUTOGEN_SWEEP_CAP=3

# ── Bulk media upload (podcast clips → GCS → Library) ────────────────
# Dedicated GCS bucket for large pre-generated video (staff "Bulk Upload
# Assets" dropzone + scripts/upload-local-clips.ts). Separate from Firebase
# Storage (NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET above, which only holds small
# logos/avatars/resumes). Signs with the same Firebase service-account
# credentials above (FIREBASE_SERVICE_ACCOUNT_KEY or the three discrete
# FIREBASE_* vars) — no separate key needed. See docs/gcs-media-setup.md for
# the one-time `gcloud` bucket/CORS/IAM setup.
GCS_MEDIA_BUCKET=

# Agent-engine WORKSPACE bucket (src/lib/agent-engine/workspace-writer.ts) —
# where the reconcile cron mirrors each engine-enabled client's knowledge base
# (clients/<slug>/knowledge/*.json). Signs with the same Firebase
# service-account credentials; that SA needs roles/storage.objectAdmin on the
# bucket. Unset = the knowledge sync is skipped, nothing else changes.
# Prep: karoscmo-prep-agent-artifacts
AGENT_ENGINE_WORKSPACE_BUCKET=

# ── Ops Import inbox (/admin/ops, admin only) ────────────────────────
# SECOND source for refresh proposals. The FIRST is the lab repo itself —
# "Check for updates" scans clients/<slug>/refresh/*.json using
# AGENTS_REPO_GITHUB_TOKEN above, and needs nothing here.
#
# Absolute path to a directory of locally-produced update bundles the admin
# Ops Import page lands in the live portal. Unset → server-dropped proposals
# are not read and SEO/GEO snapshots cannot be imported; the lab-repo source
# still works.
#   <inbox>/<anything>.json         one refresh proposal per client, in the
#                                   schema scripts/refresh-apply.ts validates
#   <inbox>/seo-geo/<clientId>.json one SEO/GEO capture per client
# POSTS are NOT read from here — they come from the lab repo via
# AGENTS_REPO_GITHUB_TOKEN above, through the existing lab-outputs importer.
# Read-only: the importer never writes to, moves, or empties the folder.
# Runbook: docs/qa-sweep-2026-07/refresh/OPS-IMPORT.md
OPS_IMPORT_DIR=

# ── Dynamic Agent Studio (/admin/agents/builder, admin only) ─────────
# Spec-driven agents an admin builds visually in the Portal, executed by
# agent-service's generic execution engine. AI-only agents need nothing here.
#
# Code steps (Python/Node snippets inside a spec's pipeline) are OFF unless
# this is exactly "true". Off is the intended default: the sandbox is real
# (see agent-service/runner/src/dynamic/code-sandbox.ts for what each hard
# requirement is enforced by) but has not had a security review, so an admin
# can author a code step and see it in the Studio while it is refused at run
# time. Set on BOTH the Portal (the Studio greys the editor out and shows a
# "Coming soon" badge when unset) and agent-service (the runner refuses the
# step when unset) — they read the same variable name independently.
DYNAMIC_CODE_STEPS_ENABLED=false

# ── Platform-injected — do not set by hand ────────────────────
# These three are supplied automatically by the runtime (Cloud Run / Next.js)
# and are read by this codebase, but are not operator config — setting them
# yourself does not change what environment you're actually running in.
# Listed here only so SCRUM-332's env-inventory script (scripts/env-inventory.ts)
# has a complete, accurate picture of everything the code reads.
#
# Standard Node.js mode flag. Cloud Run deploys hardcode NODE_ENV=production
# (see cloudbuild.yaml / cloudbuild.promote.yaml); `next dev` sets
# "development" itself.
# NODE_ENV=
# Set by Cloud Run to the deployed service's own name — used only to detect
# "are we running on Cloud Run at all" for choosing structured JSON logging
# vs. a human-readable line (src/lib/telemetry/structured-log.ts). Unset
# locally by construction (there is no Cloud Run outside Cloud Run).
# K_SERVICE=
# Set by the Next.js server runtime to "nodejs" or "edge" — used to gate
# starting the Node-only OpenTelemetry SDK (src/instrumentation.ts). Never
# set this by hand; Next.js manages it.
# NEXT_RUNTIME=
